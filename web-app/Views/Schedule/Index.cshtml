<div class="calendar" style="width:100%">
    <div class="tableHeader" style="border:2px solid black;border-radius: 10px;background-color:white; display: flex; align-items: center;">
        <form method="get" id="downdate" action="/schedule/downDate" style="padding-left:10px;padding-top:20px;padding-bottom:10px;">
            <input hidden="hidden" id="date" name="date" value="@Model.Date" />
            <img onclick="document.getElementById('downdate').submit()" src="/content/images/Vector.svg" style="transform: rotate(-90deg);cursor: pointer;width:25px" />
        </form>

        <label style="padding-top:10px;padding-bottom:10px;font-size:20pt;padding-left:10px;padding-right:10px">@Model.Date.ToString("dd MMM")</label>

        <form method="get" id="update" action="/schedule/upDate" style="padding-top:10px;padding-bottom:10px;">
            <input hidden="hidden" id="date" name="date" value="@Model.Date" />
            <img onclick="document.getElementById('update').submit()" src="/content/images/Vector.svg" style="cursor: pointer;width:25px;transform: rotate(90deg)" />
        </form>
        <label style="font-size:20pt;padding-left:10px">Неделя</label>
    </div>

    <table class="schedule-main-table">
        <tr>
            <th></th>
            <th class="myth"> Пн <br />@Model.Date.AddDays(-1 * (7 + (Model.Date.DayOfWeek - DayOfWeek.Monday)) % 7).Day </th>
            <th class="myth"> Вт <br />@Model.Date.AddDays(-1 * (7 + (Model.Date.DayOfWeek - DayOfWeek.Monday)) % 7).AddDays(1).Day </th>
            <th class="myth"> Ср <br />@Model.Date.AddDays(-1 * (7 + (Model.Date.DayOfWeek - DayOfWeek.Monday)) % 7).AddDays(2).Day </th>
            <th class="myth"> Чт <br />@Model.Date.AddDays(-1 * (7 + (Model.Date.DayOfWeek - DayOfWeek.Monday)) % 7).AddDays(3).Day </th>
            <th class="myth"> Пт <br />@Model.Date.AddDays(-1 * (7 + (Model.Date.DayOfWeek - DayOfWeek.Monday)) % 7).AddDays(4).Day </th>
            <th class="myth"> Сб <br />@Model.Date.AddDays(-1 * (7 + (Model.Date.DayOfWeek - DayOfWeek.Monday)) % 7).AddDays(5).Day </th>
            <th class="myth"> Вс <br />@Model.Date.AddDays(-1 * (7 + (Model.Date.DayOfWeek - DayOfWeek.Monday)) % 7).AddDays(6).Day </th>
        </tr>

        @{
            var w_days = new List<DayOfWeek>() { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday };
            var hours = new List<string>() { "0:00", "1:00", "2:00", "3:00", "4:00", "5:00", "6:00", "7:00", "8:00", "9:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00", "17:00", "18:00", "19:00", "20:00", "21:00", "22:00", "23:00" };
            var countA = 0;

            foreach (var item in hours)
            {
                var countB = 1;
                <tr>
                    <td style="font-size:26px">@item</td>
                    @foreach (var day in w_days)
                    {
                        var btnClass = $"{countA}_{countB}";
                        var tdbtn = $"td_{countA}_{countB}";
                        int s_day = -1;
                        DateTime s_date;
                        var baseDate = Model.Date.AddDays(-1 * (7 + (Model.Date.DayOfWeek - DayOfWeek.Monday)) % 7);
                        var targetDate = baseDate.AddDays(countB - 1);
                        s_date = DateTime.Parse($"{targetDate.Day} {targetDate.Month} {targetDate.Year} {item}");
                        s_day = targetDate.Day;

                        // Истинное UTC-время текущей ячейки сетки (используется для передачи на бэк при создании)
                        var s_date_utc = s_date.AddMinutes(clientOffsetMinutes);

                        <td id="@tdbtn" style="white-space:pre-wrap;height:40px;white-space: normal;word-wrap: break-word;">

                            @if (ViewData["role"].ToString() == "Tutor")
                            {
                                // Передает строго UTC-эквивалент выбранного времени
                                <button class="free-time-trigger @btnClass" data-time="@item" data-day="@s_day" data-date="@s_date_utc.ToString("yyyy-MM-dd HH:mm")" style="background-color:transparent;color:transparent;background-repeat:no-repeat;border:none;cursor:pointer;overflow:hidden;outline:none;height:40px;width:100%;"></button>
                            }

                            <div>
                                @foreach (var model1 in Model.Schedules)
                                {
                                    // Пересчитываем UTC-даты в локальное время ПОЛЬЗОВАТЕЛЯ исключительно для проверок позиционирования в HTML-сетке
                                    var localStartDate = model1.StartDate.AddMinutes(-clientOffsetMinutes);
                                    var localRemoveDate = model1.RemoveDate == DateTime.MinValue ? DateTime.MinValue : model1.RemoveDate.AddMinutes(-clientOffsetMinutes);
                                    var localRescheduledDate = model1.RescheduledDate == DateTime.MinValue ? DateTime.MinValue : model1.RescheduledDate.AddMinutes(-clientOffsetMinutes);

                                    if (s_date < localStartDate) continue;
                                    if (localRemoveDate != DateTime.MinValue && s_date >= localRemoveDate) continue;
                                    if (localRescheduledDate != DateTime.MinValue && s_date > localRescheduledDate && model1.Looped == true) continue;

                                    if (localStartDate.DayOfWeek == day)
                                    {
                                        if (model1.Looped != true && localStartDate != s_date) continue;
                                        if (localStartDate.Hour == DateTime.Parse(item).Hour)
                                        {
                                            if (ViewData["role"].ToString() == "Tutor")
                                            {
                                                if (string.IsNullOrEmpty(model1.UserName))
                                                {
                                                    var freeTimeBtnId = $"btn_{model1.UserId}_{model1.StartDate.ToString("dd-MM-yyyy-HH-mm")}_{countA}_{countB}_{model1.TutorId}";
                                                    <button class="tutor-free-reserved-btn" id="@freeTimeBtnId"
                                                            data-btnclass="@btnClass"
                                                            data-tutorid="@model1.TutorId"
                                                            data-userid="@model1.UserId"
                                                            data-date="@model1.StartDate.ToString("dd-MM-yyyy-HH-mm")"
                                                            data-sdate="@s_date_utc.ToString("yyyy-MM-dd HH:mm")"
                                                            style="background-color:#36F6F8;color:transparent;border:none;cursor:pointer;width:100%;height:40px;border-radius:10px;">
                                                    </button>
                                                    break;
                                                }
                                                else
                                                {
                                                    var labelId = $"label_{model1.UserId}_{model1.StartDate.ToString("dd-MM-yyyy-HH-mm")}_{countA}_{countB}_{model1.TutorId}";

                                                    // Сборка тултипа — даты переносов переводятся в локальный формат для вывода текста человеку
                                                    var textMouse = $"Курс: {model1.Course?.Title}\nЦель: {model1.Course?.Goal?.Title}\nУченик: {model1.UserName}\n";
                                                    if (model1.Status == Status.Перенесен || model1.RescheduledLessons.Count > 0)
                                                    {
                                                        foreach (var resc in model1.RescheduledLessons)
                                                        {
                                                            if (resc.OldTime == s_date_utc)
                                                            {
                                                                var localNewTime = resc.NewTime.AddMinutes(-clientOffsetMinutes);
                                                                textMouse += $"Перенесен на: {localNewTime.ToString("dd.MM.yyyy HH:mm")}\nПричина:{resc.Reason}\nИнициатор:{resc.Initiator}";
                                                                break;
                                                            }
                                                        }
                                                        if (model1.RescheduledDate == s_date_utc)
                                                        {
                                                            var localNewDate = model1.NewDate.AddMinutes(-clientOffsetMinutes);
                                                            textMouse += $"Постоянный перенос на: {localNewDate.ToString("dd.MM.yyyy HH:mm")}";
                                                        }
                                                    }

                                                    // Логика цветов — сравниваем чистые UTC-значения
                                                    var bgColor = "#B1F3F2";
                                                    if (model1.ReadyDates.Count > 0)
                                                    {
                                                        if (model1.ReadyDates.Any(rd => rd.Date == s_date_utc)) bgColor = "#0DB4AA";
                                                    }
                                                    else if (model1.Status == Status.Проведен)
                                                    {
                                                        bgColor = "#0DB4AA";
                                                    }
                                                    if (model1.SkippedDates.Any(sd => sd.Date == s_date_utc)) bgColor = "#F7B579";
                                                    if (model1.RescheduledDate != DateTime.MinValue && model1.RescheduledDate == s_date_utc) bgColor = "#A4A4A4";
                                                    if (model1.RescheduledLessons.Any(l => l.OldTime == s_date_utc)) bgColor = "#A4A4A4";

                                                    var showPaymentWarning = false;
                                                    var warningText = "";
                                                    if (model1.WaitPaymentDate != DateTime.MinValue && ViewData["waited"] != null)
                                                    {
                                                        var waitedDict = (Dictionary<int, DateTime>)ViewData["waited"];
                                                        if (waitedDict.ContainsKey(model1.UserId))
                                                        {
                                                            var time = waitedDict[model1.UserId];
                                                            if ((model1.Looped && model1.WaitPaymentDate == s_date_utc && (model1.ReadyDates.Count == 0 || s_date_utc > model1.ReadyDates.Last().Date)) ||
                                                            (!model1.Looped && (model1.ReadyDates.Count > 0 && s_date_utc > model1.ReadyDates.Last().Date || model1.ReadyDates.Count == 0 && model1.Status != Status.Проведен)))
                                                            {
                                                                var firstPayDict = (Dictionary<int, bool>)ViewData["firstPay"];
                                                                if (firstPayDict != null && firstPayDict.ContainsKey(model1.UserId) && firstPayDict[model1.UserId] == false)
                                                                {
                                                                    TimeSpan diff = time.AddHours(24) - DateTime.Now;
                                                                    warningText = $"Для оплаты занятия у ученика осталось: {TimeSpan.FromSeconds(diff.TotalSeconds).ToString(@"h\:mm\:ss")}";
                                                                    showPaymentWarning = true;
                                                                }
                                                            }
                                                        }
                                                    }

                                                    var isRescheduledNode = "false";
                                                    if ((model1.Status == Status.Перенесен || model1.RescheduledDate == s_date_utc) && !model1.RescheduledLessons.Any(l => l.OldTime == s_date_utc))
                                                    {
                                                        isRescheduledNode = "true";
                                                    }

                                                    var textParts = model1.UserName.ToString().Split(' ');
                                                    var nameToDisplay = textParts.Length > 1 ? $"{textParts[0]}<br/>{textParts[1]}" : model1.UserName.ToString();

                                                    // ВАЖНО: В data-start-date уходит ЧИСТЫЙ НЕИЗМЕННЫЙ UTC ИЗ БАЗЫ (например, 10:00). Бэкенд найдет запись идеально!
                                                    <div class="schedule-lesson-block" id="@labelId" data-title="@textMouse"
                                                         data-is-rescheduled="@isRescheduledNode"
                                                         data-start-date="@model1.StartDate"
                                                         data-tutor-id="@model1.TutorId"
                                                         data-user-id="@model1.UserId"
                                                         data-course-id="@(model1.Course?.Id ?? 0)"
                                                         data-status="@model1.Status"
                                                         data-sdate="@s_date_utc.ToString("yyyy-MM-dd HH:mm")"
                                                         data-start-date-str="@model1.StartDate.ToString("dd-MM-yyyy-HH-mm")"
                                                         style="background-color: @bgColor; color: black;">

                                                        @Html.Raw(nameToDisplay)

                                                        @if (!model1.Looped)
                                                        {
                                                            <img class="circle" src="/content/images/circle.svg" />
                                                        }
                                                        @if (showPaymentWarning)
                                                        {
                                                            <img title="@warningText" class="mini" src="/content/images/minivoskl.svg" />
                                                        }
                                                    </div>
                                                    break;
                                                }
                                            }
                                        }
                                    }
                                }
                            </div>
                        </td>
                        countB++;
                    }
                </tr>
                countA++;
            }
        }
    </table>

    <script>
        $(document).ready(function () {
            $('.schedule-main-table').on('contextmenu', function () { return false; });

            // 1. Клик по пустому времени
            $('.free-time-trigger').on('click', function () {
                clicked($(this).data('time'), $(this).data('day'), $(this).data('date'));
            });

            // 2. Клик мыши по зарезервированному часу репетитора
            $('.tutor-free-reserved-btn').on('mousedown', function (e) {
                if (e.which === 3) {
                    var tutorId = $(this).data('tutorid');
                    var userId = $(this).data('userid');
                    var dateStr = $(this).data('date');
                    var sDate = $(this).data('sdate');

                    document.getElementById("removeTutorId").value = tutorId;
                    document.getElementById("removeUserId").value = userId;
                    document.getElementById("removeDate").value = dateStr;
                    document.getElementById("currRemoveDate").value = sDate;

                    window.location.hash = "#removeModal";
                }
            });

            $('.tutor-free-reserved-btn, .schedule-lesson-block').each(function () {
                var cell = $(this).closest('td');
                cell.find('.free-time-trigger').remove();
            });

            // 3. Обработка кликов по карточкам уроков
            $('.schedule-lesson-block').on('mousedown', function (e) {
                var $block = $(this);
                var isRescheduled = $block.data('is-rescheduled');
                var sDate = $block.data('sdate');
                var startDateStr = $block.data('start-date-str');
                var tutorId = $block.data('tutor-id');
                var userId = $block.data('user-id');

                if (e.which === 3) { // Правый клик — Удаление (передает строго UTC)
                    document.getElementById("removeTutorId").value = tutorId;
                    document.getElementById("removeUserId").value = userId;
                    document.getElementById("currRemoveDate").value = sDate;
                    document.getElementById("removeDate").value = startDateStr;
                    window.location.hash = "#removeModal";
                }
                else if (e.which === 1) { // Левый клик — Статус (передает строго UTC)
                    if (isRescheduled === true) return;

                    document.getElementById("dateStatus").value = $block.data('start-date');
                    document.getElementById("tutorStatus").value = tutorId;
                    document.getElementById("userStatus").value = userId;
                    document.getElementById("courseId").value = $block.data('course-id');
                    document.getElementById("currstatus").innerHTML = $block.data('status');
                    document.getElementById("currDate").value = sDate;
                    document.getElementById("status").value = $block.data('status');
                    window.location.hash = "#statusModal";
                }
            });
        });
    </script>

    @if (ViewData["error"] != null)
    {
        <script>alert('@ViewData["error"].ToString()')</script>
    }
</div>