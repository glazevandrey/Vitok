    <div id="statusModal" class="modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 class="modal-title">Выберите статус занятия</h3>
                    <a onclick="closeModalWindowStatus()" title="Close" class="close">×</a>
                </div>
                <div class="modal-body">
                    <script>
                        function changesStatus(value) {
                            if (value.value === 'Перенесен') {
                                document.getElementById('rescheduleDiv').style.display = 'block';
                                document.getElementById('skippedDiv').style.display = 'none';
                            } else if (value.value == 'Пропущен') {
                                document.getElementById('skippedDiv').style.display = 'block';
                                document.getElementById('rescheduleDiv').style.display = 'none';
                            } else {
                                document.getElementById('skippedDiv').style.display = 'none';
                                document.getElementById('rescheduleDiv').style.display = 'none';
                            }
                        }
                    </script>
                    <br />
                    <label>Текущий статус занятия:</label>
                    <label id="currstatus" class="u-custom-color-1 u-input u-input-rectangle u-radius-10" style="box-shadow: 5px 5px 20px 0 rgba(0,0,0,0.4);width:130px;background-color:#fff;display:inline-block;"></label>
                    <br /><br />
                    <label>Изменить статус занятия:</label>
                    <br />
                    <form method="post" id="rescheduleForm" action="/schedule/changeStatus">
                        <select style="width:130px;font-size:20px" name="status" id="status" onchange="changesStatus(this)">
                            @foreach (Status item in Enum.GetValues(typeof(web_server.Models.Status)))
                            {
                                if (item == Status.ОжидаетОплату || item == Status.Ожидает) continue;
                                <option value="@item">@item</option>
                            }
                        </select>
                        <br />
                        <script>
                            function validateDate() {
                                if (!document.getElementById('status').value) return;
                                if ((!document.getElementById('newTime').value || !document.getElementById('newDate').value) && document.getElementById('rescheduleDiv').style.display != 'none') {
                                    document.getElementById('timeError').style.display = 'inline-block';
                                    return;
                                } else {
                                    document.getElementById('timeError').style.display = 'none';

                                    // КРИТИЧЕСКИЙ ПЕРЕВОД: берем локальный выбор даты/времени юзера и превращаем в UTC перед отправкой!
                                    if (document.getElementById('rescheduleDiv').style.display !== 'none') {
                                        var localDateStr = document.getElementById('newDate').value;
                                        var localHour = parseInt(document.getElementById('newTime').value);
                                        if (localDateStr && !isNaN(localHour)) {
                                            var parts = localDateStr.split('-');
                                            var localDate = new Date(parts[0], parts[1] - 1, parts[2], localHour, 0, 0);

                                            var utcYear = localDate.getUTCFullYear();
                                            var utcMonth = String(localDate.getUTCMonth() + 1).padStart(2, '0');
                                            var utcDay = String(localDate.getUTCDate()).padStart(2, '0');
                                            var utcHour = String(localDate.getUTCHours());

                                            document.getElementById('newDate').value = `${utcYear}-${utcMonth}-${utcDay}`;
                                            document.getElementById('newTime').value = utcHour;
                                        }
                                    }

                                    document.getElementById('rescheduleForm').submit();
                                }
                            }
                        </script>

                        <div id="skippedDiv" style="display:none">
                            <br /><br />
