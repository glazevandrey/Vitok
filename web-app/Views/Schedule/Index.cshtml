@model DisplayModelShedule
<script>
    // Определение смещения часового пояса клиента (UTC минус Местное время в минутах)
    (function () {
        const cookieName = "clientTimezoneOffset";
        const currentOffset = new Date().getTimezoneOffset();
        const hasCookie = document.cookie.split('; ').find(row => row.startsWith(cookieName + '='));
        if (!hasCookie || parseInt(hasCookie.split('=')[1]) !== currentOffset) {
            document.cookie = cookieName + "=" + currentOffset + "; path=/; max-age=31536000";
            window.location.reload();
        }
    })();
</script>

@{
    Layout = "_Layout";

    int clientOffsetMinutes = 0;
    if (Context.Request.Cookies.TryGetValue("clientTimezoneOffset", out string offsetStr) && int.TryParse(offsetStr, out int parsedOffset))
    {
        clientOffsetMinutes = parsedOffset;
    }
}

